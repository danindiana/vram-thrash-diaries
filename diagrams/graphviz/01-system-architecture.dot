digraph SystemArchitecture {
  bgcolor="#0d0620";
  fontname="Courier New";
  fontcolor="#f5f3ff";
  labelloc="t";
  fontsize=20;
  label="01 — System Architecture";
  rankdir=TB;
  pad=0.4;
  nodesep=0.45;
  ranksep=0.6;

  node [style=filled, fillcolor="#1a1033", fontname="Courier New", fontsize=12, fontcolor="#f5f3ff", penwidth=2, shape=box, margin=0.18];
  edge [color="#f472b6", fontname="Courier New", fontsize=10, fontcolor="#facc15", penwidth=1.6, arrowsize=0.8];

  subgraph cluster_client {
    label="Interactive clients"; fontcolor="#22d3ee"; color="#22d3ee"; style="rounded"; bgcolor="#160b2e";
    HA [label="Hermes Agent\n(CLI, tool loop, mem0 plugin)", color="#22d3ee"];
    QC [label="Qwen Code\n(CLI coding agent)", color="#22d3ee"];
  }

  subgraph cluster_daemon {
    label="Ollama daemon :11434 (ollama.service)"; fontcolor="#facc15"; color="#facc15"; style="rounded"; bgcolor="#160b2e";
    SCHED [label="Scheduler\nMAX_LOADED_MODELS=3\nNUM_PARALLEL=1\nGPU_OVERHEAD=1GiB/GPU", color="#facc15", fillcolor="#241541"];
  }

  subgraph cluster_gpu {
    label="GPUs"; fontcolor="#34d399"; color="#34d399"; style="rounded"; bgcolor="#160b2e";
    GPU0 [label="GPU 0\nRTX 4080 SUPER (16GB)", color="#34d399"];
    GPU1 [label="GPU 1\nRTX 5070 (12GB)", color="#34d399"];
  }

  CPU [label="CPU / System RAM\n(176GB free)", color="#a78bfa"];

  subgraph cluster_mem {
    label="Memory layer (mem0, OSS mode)"; fontcolor="#f472b6"; color="#f472b6"; style="rounded"; bgcolor="#160b2e";
    EXTRACT [label="mem0-extractor-cpu\n(qwen3:4b, num_gpu=0)", color="#f472b6"];
    EMBED [label="nomic-embed-text\n(small, GPU)", color="#f472b6"];
    QDRANT [label="Qdrant (embedded, on-disk)\nper-profile store", color="#f472b6"];
  }

  HA -> SCHED [label="OpenAI-compatible API"];
  QC -> SCHED [label="OpenAI-compatible API"];
  SCHED -> GPU0 [label="chat model\n(tensor-split)"];
  SCHED -> GPU1 [label="chat model\n(tensor-split)"];
  SCHED -> GPU1 [label="EMBED"];
  SCHED -> CPU [label="EXTRACT (CPU-only)", color="#a78bfa"];
  HA -> EXTRACT [label="memory calls", style=dashed, color="#facc15"];
  EXTRACT -> QDRANT;
  EMBED -> QDRANT;
}
