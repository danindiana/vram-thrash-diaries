digraph PromptCaching {
  bgcolor="#0d0620";
  fontname="Courier New";
  fontcolor="#f5f3ff";
  labelloc="t";
  fontsize=20;
  label="30 — Prompt / Context Caching Mechanics";
  rankdir=TB;
  pad=0.4;
  nodesep=0.4;
  ranksep=0.45;

  node [style=filled, fillcolor="#1a1033", fontname="Courier New", fontsize=11, fontcolor="#f5f3ff", penwidth=2, shape=box, margin=0.16];
  edge [color="#a78bfa", fontname="Courier New", fontsize=10, fontcolor="#facc15", penwidth=1.6, arrowsize=0.75];

  A [label="Turn 1: full prompt processed,\nKV-cache built token-by-token\n(the slow 'prefill' pass)", color="#22d3ee"];
  B [label="KV-cache for the SHARED\nprefix kept in memory\n(system prompt, prior turns)", color="#facc15", fillcolor="#241541"];
  C [label="Turn 2: only the NEW tokens\nneed prefill — prefix reused", color="#34d399"];
  D [label="Big latency win on long,\nmulti-turn conversations", color="#34d399"];

  A -> B -> C -> D;

  subgraph cluster_seen {
    label="Seen this session"; fontcolor="#f472b6"; color="#f472b6"; style="rounded"; bgcolor="#1e0b16";
    S1 [label="Ollama log line:\n'looking for better prompt,\nbase f_keep, f_sim' — this IS\nthe prefix-cache lookup", color="#f472b6"];
    S2 [label="prompt cache is enabled,\nsize limit: 8192 MiB\n(seen in load_model logs)", color="#f472b6"];
  }

  B -> S1 [style=dashed];

  NOTE [label="Cache is PER LOADED MODEL —\nanother reason eviction thrashing\nwas so costly: every reload\nthrows the prefix cache away too", shape=note, color="#f87171", fillcolor="#2a0f1a", fontsize=10];
  D -> NOTE [style=dashed];
}
