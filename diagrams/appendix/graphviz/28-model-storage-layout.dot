digraph ModelStorageLayout {
  bgcolor="#0d0620";
  fontname="Courier New";
  fontcolor="#f5f3ff";
  labelloc="t";
  fontsize=20;
  label="28 — Model Storage & Blob Deduplication";
  rankdir=TB;
  pad=0.4;
  nodesep=0.4;
  ranksep=0.45;

  node [style=filled, fillcolor="#1a1033", fontname="Courier New", fontsize=11, fontcolor="#f5f3ff", penwidth=2, shape=box, margin=0.16];
  edge [color="#a78bfa", fontname="Courier New", fontsize=10, fontcolor="#facc15", penwidth=1.6, arrowsize=0.75];

  TAG1 [label="dler-r1-7b:latest\n(manifest)", color="#22d3ee"];
  TAG2 [label="dler-r1-7b-64k:latest\n(manifest, derived)", color="#22d3ee"];
  BLOB1 [label="blob sha256-1fb8a1f7...\n(the actual weights, 8.1GB)", color="#facc15", fillcolor="#241541"];
  BLOB2 [label="blob sha256-...\n(the num_ctx=65536 layer,\nsmall — just config)", color="#34d399"];

  TAG1 -> BLOB1;
  TAG2 -> BLOB1 [label="SAME blob,\nreused via content hash"];
  TAG2 -> BLOB2;

  NOTE [label="This is why creating\ndler-r1-7b-64k and\nmem0-extractor-cpu this session\ncost ~0 extra disk — only new\nconfig layers were written,\nweights were shared by hash", shape=note, color="#f472b6", fillcolor="#1e0b16", fontsize=10];
  BLOB1 -> NOTE [style=dashed];

  subgraph cluster_maint {
    label="Maintenance"; fontcolor="#38bdf8"; color="#38bdf8"; style="rounded"; bgcolor="#0b1a2a";
    M1 [label="ollama list — see all tags\n+ sizes (this box: 40+ models)"];
    M2 [label="unused blobs pruned on\nollama restart UNLESS\nOLLAMA_NOPRUNE is set"];
  }
}
